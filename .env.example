# Copy this to .env and fill in real values for local dev.

# SQLite file, relative to the prisma/ directory. For a real deployment point this at a
# stable absolute path (e.g. file:/Users/you/poller-data/poller.db?connection_limit=1).
# connection_limit=1 keeps all queries on one connection (no SQLITE_BUSY between them).
DATABASE_URL="file:./poller.db?connection_limit=1"

# Shared password for the /admin login screen.
ADMIN_PASSWORD="change-me"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-too"

# Absolute base URL of the deployed app, used to build the QR code links.
# For local dev, http://localhost:3000 is fine.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
