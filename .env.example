# Copy this to .env and fill in real values for local dev.

# Local dev: matches docker-compose.yml. In Render, this is provided automatically
# by the linked Postgres instance.
DATABASE_URL="postgresql://poller:poller@localhost:5433/poller"

# Shared password for the /admin login screen.
ADMIN_PASSWORD="change-me"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-too"

# Absolute base URL of the deployed app, used to build the QR code links.
# For local dev, http://localhost:3000 is fine.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
