generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "CS440"
  name      String? // optional friendly label
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  polls       Poll[]
}

model Student {
  id            String   @id @default(cuid())
  emailUsername String   @unique // e.g. "jdoe123"
  campusId      String // e.g. "A12345678" -- used as login password
  firstName     String
  lastName      String
  createdAt     DateTime @default(now())

  enrollments Enrollment[]
  responses   Response[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

model Poll {
  id         String   @id @default(cuid())
  classId    String
  number     Int // sequential per class, for display (1, 2, 3, ...)
  label      String? // optional admin-facing note about the poll
  numChoices Int      @default(4) // how many of A-E are valid, 2-5
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([classId, number])
  @@index([classId, isActive])
}

model Response {
  id        String   @id @default(cuid())
  pollId    String
  studentId String
  choice    String // "A".."E"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll    Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId])
  @@index([studentId])
}
